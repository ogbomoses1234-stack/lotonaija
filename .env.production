# Use mock API in production (set to 'false' to use real backend)
VITE_USE_MOCK_API=true

# Real API URL (only used when VITE_USE_MOCK_API=false)
VITE_API_URL=https://api.lottong.ng/v1

# Payment gateway keys (mock ignores these)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_mock
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_mock